# =============================================================================
# jellyfin-gate configuration
#
# Copy to `.env` in the project root and fill in. Next.js loads `.env`
# automatically; `.env.local` takes precedence if both exist.
#
# On Windows, do NOT wrap values in quotes unless the value itself contains
# spaces — cmd and PowerShell handle quoting differently and Next reads the
# file directly, so quotes end up as part of the value.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Admin key for /api/admin/*, sent as the `X-Admin-Key` header. This key can
# create Jellyfin accounts, so treat it like a root password. Minimum 32
# characters — the app refuses to start with anything shorter.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=

# Jellyfin API key, used for user creation, policy changes and deletion.
# Create at: Jellyfin Dashboard -> Advanced -> API Keys -> "+"
# Name it something like "jellyfin-gate" so it can be revoked independently.
JELLYFIN_API_KEY=

# Public origin of this app, no trailing slash. Used to build the invite URLs
# returned by POST /api/admin/invites — get this wrong and every invite link you
# hand out points somewhere useless.
#   production: https://watch.example.com
#   local dev:  http://localhost:3000
PUBLIC_URL=https://watch.example.com


# -----------------------------------------------------------------------------
# OPTIONAL — sensible defaults, override only if needed
# -----------------------------------------------------------------------------

# Jellyfin's base URL. Loopback because Jellyfin runs natively on the same
# Windows box and should not be listening on anything else.
JELLYFIN_URL=http://127.0.0.1:8096

# SQLite file. Relative paths resolve against the project root. On Windows use
# forward slashes or doubled backslashes.
#   DATABASE_PATH=C:/ProgramData/jellyfin-gate/jellyfin-gate.db
# The file contains live Jellyfin access tokens — keep it off any shared drive
# and out of any backup that leaves the machine unencrypted.
DATABASE_PATH=./data/jellyfin-gate.db

# Trust the `CF-Connecting-IP` header for rate-limit bucketing.
#
# ONLY set this to true once the app genuinely cannot be reached except through
# Cloudflare (a cloudflared tunnel, or a firewall that only admits Cloudflare's
# IP ranges). It is an ordinary request header: if anything can reach this app
# directly, it can forge a new value on every request and the login rate limit
# stops existing.
TRUST_CF_CONNECTING_IP=false

# Session lifetime in days, and how much of that lifetime must elapse before an
# active session is renewed. Renewal is lazy on purpose — see the comment in
# src/lib/session.ts. Lower SESSION_RENEW_AFTER_HOURS means more SQLite writes
# on a box that does not have the IO budget to waste.
SESSION_TTL_DAYS=30
SESSION_RENEW_AFTER_HOURS=24

# Defaults applied when POST /api/admin/invites omits `max_uses` /
# `expires_in_days`.
INVITE_DEFAULT_MAX_USES=1
INVITE_DEFAULT_EXPIRY_DAYS=7

# Port for `next start`. Keep this bound to loopback in production and let
# cloudflared or a reverse proxy be the only thing that can reach it.
PORT=3000
HOSTNAME=127.0.0.1

# Session cookie `Secure` attribute. Defaults to true in production.
#
# Browsers DISCARD Secure cookies over plain http, so login silently fails when
# testing from another device at http://192.168.x.x:3000. Set false for LAN
# testing over http; set back to true before this faces the internet.
COOKIE_SECURE=true

# Docker compose only: host path to your media, mounted read-only at /media
# inside the Jellyfin container.
MEDIA_PATH=/path/to/movies

# Docker compose only: interface the gate publishes on.
#   0.0.0.0   reachable from the LAN (testing)
#   127.0.0.1 loopback only, with cloudflared in front (production)
GATE_BIND=127.0.0.1

# -----------------------------------------------------------------------------
# WATCH FOLDER (scripts/media-worker.mjs)
# -----------------------------------------------------------------------------

# Drop zone for new files. MUST NOT be inside MEDIA_LIBRARY, and Jellyfin must
# not be pointed at it: Jellyfin indexes a converted file sitting beside its
# source as a SECOND movie with the same name, not another version of it.
# Originals are moved to $MEDIA_INCOMING/.processed after conversion, never
# deleted.
MEDIA_INCOMING=/srv/media/incoming

# Where converted files are published. This is the only path Jellyfin's library
# should point at.
MEDIA_LIBRARY=/srv/media/movies

# How often to check the drop zone. A file is only picked up once its size has
# been unchanged across two consecutive polls, so a large copy is never
# transcoded half-finished.
WATCH_POLL_SECONDS=30

# Override if ffmpeg/ffprobe are not on PATH (e.g. Windows).
#   FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
#   FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

# Ratings from IMDb, Rotten Tomatoes and Metacritic, via OMDb. Optional: with
# no key the detail page falls back to Jellyfin's own TMDB score.
# Free tier is 1000 requests/day; results are cached locally for a week, so a
# library of any normal size stays well inside it.
# Get one at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Optional: lets viewers fetch subtitles from OpenSubtitles for a film that
# has none. With no key, the feature simply doesn't offer itself — nothing
# else in the app depends on it.
# Consumer-level key from https://www.opensubtitles.com/en/consumers — set
# the consumer to "Under Development" there for up to 100 downloads/day with
# no per-user login (search itself has no daily limit either way).
OPENSUBTITLES_API_KEY=

# Optional: powers two things. (1) Library Review's "Change poster" action
# (Browse Library panel) — a curator picking a different TMDB poster than
# whatever Jellyfin's own scan settled on; with no key, that button 503s.
# (2) parental control's content-warning backfill (content-warnings.ts) —
# checks a title's certification across every country TMDB has one for
# (not just the US) plus its content keywords, to catch adult content in
# titles Jellyfin never got an MPAA-equivalent rating for at all. With no
# key, parental control still works off Jellyfin's own OfficialRating alone.
# Use the v4 "API Read Access Token" (a long JWT), not the shorter v3 API
# key — get one at https://www.themoviedb.org/settings/api.
TMDB_READ_ACCESS_TOKEN=

# Optional: a second, independent content-warning signal for parental
# control, alongside TMDB — Does the Dog Die's crowdsourced database
# (Sex/Sexual Assault/Violence/Bodily Harm categories specifically). With no
# key, parental control still works off Jellyfin's rating + TMDB alone.
# Free tier: non-commercial use only, 30 req/min, 5,000/month. Get a key
# from your profile at https://www.doesthedogdie.com after signing up.
# Their Terms require visible "Powered by DoesTheDogDie.com" attribution
# wherever this data is used — see the note in curator.html's Users tab
# before enabling this in a deployment other people can see.
DDD_API_KEY=

# Optional. When both are set, an invite created with an email address sends
# itself immediately via Resend's API (a plain HTTP call, no SDK) instead of
# only handing the link back to the curator to copy. With either unset, the
# console still creates the invite and gives you the link to copy/share by
# hand -- email is a convenience layered on top, not a requirement.
# Get a key at https://resend.com/api-keys — the free tier covers this
# comfortably. INVITE_EMAIL_FROM must be a verified sender/domain in your
# Resend account (e.g. "Watch <invites@yourdomain.com>").
RESEND_API_KEY=
INVITE_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Host differences
#
# The base docker-compose.yml runs anywhere. The two things that are not
# portable — GPU passthrough and the cloudflared credentials path — are set
# here rather than baked into the compose file.
# ---------------------------------------------------------------------------

# LINUX ONLY. Pulls in the hardware-transcoding overlay so a plain
# `docker compose up -d` gets GPU access without extra flags. Leave this unset
# on Windows: /dev/dri does not exist there, and Docker Desktop's WSL2 backend
# cannot pass a render node through, so naming the device stops the container
# starting at all rather than falling back to software.
#   COMPOSE_FILE=docker-compose.yml:docker-compose.linux.yml

# LINUX ONLY, and only with the overlay above. Must match
#   stat -c %g /dev/dri/renderD128
# Wrong value = device present but unreadable = silent software encoding.
#   RENDER_GID=110

# Where `cloudflared tunnel login` put its certificate and credentials.
# Defaults to $HOME/.cloudflared, which is right on Linux and does not exist
# on Windows, where $HOME is not set at all. Forward slashes — compose does
# not want the backslashes Explorer shows you.
#   CF_CREDS_DIR=C:/Users/Mamnani/.cloudflared

# The uid:gid cloudflared runs as. On Linux it has to be the owner of the
# credentials directory (0700, so the image's default uid 65532 cannot even
# traverse it). On Windows there are no such permissions to satisfy — Docker
# Desktop presents bind mounts as world-readable — so use root and move on.
#   CF_USER=0:0

# Media paths on Windows. Same forward-slash rule. Keep MEDIA_INCOMING outside
# MEDIA_PATH: Jellyfin indexes a converted file sitting beside its source as a
# second movie rather than another version of it.
#   MEDIA_PATH=D:/Media/movies
#   MEDIA_INCOMING=D:/Media/incoming

# Watch-party realtime service (scripts/party-server.mts / docker-compose.yml's
# `party` service — not started by default yet, see that service's own
# comment). PARTY_PORT is what the party container listens on internally.
# NEXT_PUBLIC_PARTY_WS_PATH is the same-origin path the browser connects to —
# baked into the client bundle at build time (Next's NEXT_PUBLIC_ convention),
# so changing it needs a rebuild, not just a container restart. Production
# needs a cloudflared ingress rule (or equivalent reverse-proxy rule) routing
# that path to the party container; see DESIGN-watch-party.md.
#   PARTY_PORT=4001
#   NEXT_PUBLIC_PARTY_WS_PATH=/ws/party
