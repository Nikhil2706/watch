<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV. One APK serves phone and TV rather than a second build:
         same signing key, same self-update channel, one thing to hand out.

         Both of these must be required="false" or the app is filtered out of
         the TV Play listing and, more immediately, refuses to install on a TV
         box. A television has no touchscreen, and leanback is a TV-only
         library this app does not link against — it wraps the same web UI
         either way. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- android:banner on <application> below is the 320x180 image the TV
         launcher shows instead of the launcher icon; without one the app is
         effectively invisible in the TV app row. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:banner="@drawable/tv_banner">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- The TV launcher only lists activities carrying this
                     category; LAUNCHER alone is ignored there, which is why a
                     perfectly working phone app simply does not appear on a
                     television. Both categories on one activity means one APK
                     covers both. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Downloads (see MainActivity's DownloadListener). From API 29 the
         DownloadManager writes to the public Downloads folder without any
         permission at all; this is only for the API 23-28 range that minSdk
         still admits, which is why it is capped. MainActivity falls back to
         app-private storage if it is missing, so a download never just fails. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Self-update (see UpdateChecker). There is no store to do this for us,
         so the app fetches its own APK and hands it to the system installer.
         Play restricts this permission heavily; that is irrelevant here and
         would be the thing to revisit if this app ever went to a store.
         It does NOT permit a silent install - the system's own confirmation
         screen always appears, and the user must additionally allow
         "install unknown apps" for this app on API 26+. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
