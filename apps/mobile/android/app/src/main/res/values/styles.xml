<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme.

         Parent changed off Capacitor's default Theme.AppCompat.Light.DarkActionBar:
         the app it wraps is dark, and a Light parent meant every launch and every
         WebView reflow had a white ground behind it. DayNight.NoActionBar rather
         than a hard .Dark so the shell still follows the device setting where any
         of it shows at all - the page itself is dark either way. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/brandBackground</item>
        <item name="android:statusBarColor">@color/brandBackground</item>
        <item name="android:navigationBarColor">@color/brandBackground</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- The launch/splash theme. windowSplashScreenBackground is what Android 12+
         actually paints; android:background is the pre-12 path. Both are set to
         the brand ground so there is no white frame on either. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/brandBackground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
