{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watch",
  "version": "1.0.0",
  "identifier": "com.abhigyanverma.watch",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Watch",
        "url": "https://watch.abhigyanverma.com",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "abhigyanverma",
    "shortDescription": "Watch",
    "longDescription": "Desktop shell for the Watch film library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
