{
  "name": "jellyfin-gate",
  "version": "0.1.0",
  "private": true,
  "description": "Invite-only authentication gateway and authenticated proxy in front of a self-hosted Jellyfin server.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/**/*.test.ts\"",
    "db:init": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/init-db.mts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "@vidstack/react": "^1.15.6",
    "cheerio": "^1.2.0",
    "hls.js": "^1.6.17",
    "next": "16.3.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0"
  }
}
